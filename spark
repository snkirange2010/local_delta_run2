spark.serializer org.apache.spark.serializer.KryoSerializer spark.kryo.unsafe true spark.kryoserializer.buffer.max 512m spark.executor.memory 20g spark.executor.memoryOverhead 6g spark.executor.cores 4 spark.driver.memory 12g spark.driver.memoryOverhead 4g spark.driver.maxResultSize 4g spark.executor.extraJavaOptions -XX:+UseG1GC -XX:G1HeapRegionSize=16m -XX:InitiatingHeapOccupancyPercent=35

spark.conf.set("spark.sql.shuffle.partitions", "200")
spark.conf.set("spark.sql.files.maxPartitionBytes", "67108864")
spark.conf.set("spark.sql.files.maxRecordsPerFile", "1000000")
spark.conf.set("spark.sql.adaptive.enabled", "true")
spark.conf.set("spark.sql.adaptive.coalescePartitions.enabled", "true")
spark.conf.set("spark.sql.adaptive.coalescePartitions.minPartitionSize", "67108864")
spark.conf.set("spark.sql.adaptive.skewJoin.enabled", "true")
spark.conf.set("spark.sql.sources.partitionOverwriteMode", "dynamic")
